# =====================================================
# Attendance Management System — Environment Variables
# Copy this file to .env.local and fill in your values
# =====================================================

# MongoDB Atlas connection string
# Get from: https://cloud.mongodb.com (free M0 tier)
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.xxxxx.mongodb.net/attendance?retryWrites=true&w=majority

# JWT secret for signing auth tokens (use a long random string)
JWT_SECRET=replace-this-with-a-long-random-secret-string

# -----------------------------------------------------
# Google Drive API — OAuth2 (for image uploads)
# Setup: https://console.cloud.google.com/
#   1. Create a project, enable Google Drive API
#   2. Create OAuth2 credentials (Web Application)
#   3. Add redirect URI: http://localhost:3333/callback
#   4. Run get-refresh-token.js to obtain the refresh token
# -----------------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=your-oauth2-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-your-client-secret
GOOGLE_OAUTH_REFRESH_TOKEN=your-refresh-token
GOOGLE_DRIVE_FOLDER_ID=the-id-of-the-drive-folder

# Optional: admin bootstrap email — first signup with this email becomes admin
ADMIN_EMAIL=admin@example.com
