# =====================================================
# Attendance Management System — Environment Variables
# Copy this file to .env.local and fill in your values
# =====================================================

# MongoDB Atlas connection string
# Get from: https://cloud.mongodb.com (free M0 tier)
MONGODB_URI=mongodb+srv://shrirahul35:<Rabhsa@0006>@wefourclucter.oabb2.mongodb.net/?appName=weFourClucter

# JWT secret for signing auth tokens (use a long random string)
JWT_SECRET=replace-this-with-a-long-random-secret-string

# -----------------------------------------------------
# Google Drive API (for image uploads)
# Setup: https://console.cloud.google.com/
#   1. Create a project
#   2. Enable Google Drive API
#   3. Create a Service Account
#   4. Download the JSON key
#   5. Share a Drive folder with the service account email
# -----------------------------------------------------
GOOGLE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_FOLDER_ID=the-id-of-the-shared-drive-folder

# Optional: admin bootstrap email — first signup with this email becomes admin
ADMIN_EMAIL=admin@example.com
